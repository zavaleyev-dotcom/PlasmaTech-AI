# Optional contact email for Crossref's polite pool. No API key is required.
CROSSREF_CONTACT_EMAIL=

# Optional free OpenAlex key for a higher request budget. Keyless mode also works.
# Never prefix this variable with NEXT_PUBLIC_. Never commit a real key.
OPENALEX_API_KEY=

# Absolute path to a read-only local PDF library (server-side only).
SCIENTIFIC_LIBRARY_PATH=

# Optional: enables the "Спросить библиотеку" (RAG) answer generation step.
# Without it, retrieval and citations still work; the UI explains that generation
# is not configured. Never prefix with NEXT_PUBLIC_. Never commit a real key.
OPENAI_API_KEY=
# Optional: defaults to gpt-4o-mini when OPENAI_API_KEY is set.
OPENAI_MODEL=

# Optional: enables SEMANTIC embedding indexing/search as a separate, explicit opt-in from
# OPENAI_API_KEY above - setting OPENAI_API_KEY alone (for RAG answers) never enables this.
# Only "openai" is implemented. Leaving this unset (the default) means semantic search is
# unavailable and "Спросить библиотеку" transparently uses lexical (FTS5) search only.
# Turning this on sends chunk text (and questions, in "semantic"/"hybrid" search mode) to
# OpenAI's Embeddings API - see src/services/embeddings/providers/openai.ts. No filename,
# path, or other metadata is ever sent, only the raw text. Building the FULL embedding index
# still requires a separate, explicit script run (scripts/index-embeddings.ts, sample-only
# in this stage) - it is never triggered automatically just by setting this variable.
EMBEDDING_PROVIDER=
# Optional: defaults to text-embedding-3-small.
EMBEDDING_MODEL=
# Optional: defaults to 1536 (text-embedding-3-small's native size).
EMBEDDING_DIMENSION=
